# URL pública del sitio, para las vistas previas al compartir links (WhatsApp, Instagram).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Nominatim (OpenStreetMap) pide identificar la app con un contacto.
GEOCODER_USER_AGENT="viasap/0.1 (tu-contacto@ejemplo.com)"

# Firma la sesión del panel (/admin). Obligatoria en producción: una frase larga al azar,
# por ejemplo la salida de `openssl rand -base64 32`.
ADMIN_SESSION_SECRET=

# Carpeta donde se guardan pedidos, tiendas editadas y fotos subidas (por defecto, ./data).
# VIASAP_DATA_DIR=/var/lib/viasap
